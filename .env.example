# Copy this file to .env and fill in the values. Never commit .env.
# Every variable uses the HW_CHECKER_ prefix. Non-secret settings live in config.yaml;
# any of them can also be overridden here or in the environment, for example
# HW_CHECKER_MAX_PARALLEL_REPOS=2 or HW_CHECKER_LOGGING__LEVEL=DEBUG.

# GitHub personal access token used to read student repos and open PRs.
# Optional for now: nothing uses it yet.
HW_CHECKER_GITHUB_TOKEN=

# API key of the OpenAI-compatible LLM endpoint in config.yaml (llm.base_url): an
# OpenRouter key for development (https://openrouter.ai/settings/keys). Nothing in a round
# needs it yet; check it with: uv run python -m hw_checker llm-check
HW_CHECKER_LLM__API_KEY=

# LangSmith tracing must stay off (the round's state holds students' names and findings).
# Do not add LANGSMITH_* or LANGCHAIN_* variables here; langgraph.json sets
# LANGSMITH_TRACING=false for LangGraph Studio.

# Author of fix commits, as students will see it. Use your GitHub no-reply address
# (<id>+<username>@users.noreply.github.com, shown under GitHub Settings > Emails) so a
# personal email is never exposed. Required only for committing fixes.
HW_CHECKER_GIT__COMMIT_AUTHOR_NAME=
HW_CHECKER_GIT__COMMIT_AUTHOR_EMAIL=
