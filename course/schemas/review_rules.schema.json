{
  "$defs": {
    "ApprovedNote": {
      "additionalProperties": false,
      "description": "A note in the approved wording: the judge never reports a note that contains\n`words` (compared ignoring case).",
      "properties": {
        "words": {
          "title": "Words",
          "type": "string"
        },
        "what": {
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "words",
        "what"
      ],
      "title": "ApprovedNote",
      "type": "object"
    },
    "FixExample": {
      "additionalProperties": false,
      "description": "An invented situation and the plan that handles it, in the style of the approved\nPRs. `plan` is shown exactly as written: the reply's JSON.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "applies_to": {
          "items": {
            "$ref": "#/$defs/ReviewRole"
          },
          "minItems": 1,
          "title": "Applies To",
          "type": "array"
        },
        "files": {
          "default": [],
          "items": {
            "pattern": "^\\.\\w+$",
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "when_found": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "When Found",
          "type": "array"
        },
        "until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until"
        },
        "replaces": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replaces"
        },
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "status": {
          "$ref": "#/$defs/ItemStatus"
        },
        "situation": {
          "title": "Situation",
          "type": "string"
        },
        "plan": {
          "title": "Plan",
          "type": "string"
        }
      },
      "required": [
        "id",
        "applies_to",
        "origin",
        "status",
        "situation",
        "plan"
      ],
      "title": "FixExample",
      "type": "object"
    },
    "ForbiddenText": {
      "additionalProperties": false,
      "description": "Text an edit must never add, checked by the guardrail before any edit is applied.\n\nExactly one of `text` (literal) and `pattern` (a regular expression) is given. By\ndefault an added line that contains it is rejected; with `new_only`, only an edit\nthat adds an occurrence (the replacement holds more than the original).",
      "properties": {
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "pattern": {
          "default": "",
          "title": "Pattern",
          "type": "string"
        },
        "ignore_case": {
          "default": false,
          "title": "Ignore Case",
          "type": "boolean"
        },
        "new_only": {
          "default": false,
          "title": "New Only",
          "type": "boolean"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "ForbiddenText",
      "type": "object"
    },
    "ItemStatus": {
      "description": "A drafted item waits for the developer's approval; a round refuses drafts (§8.3).",
      "enum": [
        "draft",
        "approved"
      ],
      "title": "ItemStatus",
      "type": "string"
    },
    "Origin": {
      "additionalProperties": false,
      "description": "The source of an item, and the words it is based on.",
      "properties": {
        "source": {
          "$ref": "#/$defs/OriginSource"
        },
        "quote": {
          "default": "",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "Origin",
      "type": "object"
    },
    "OriginSource": {
      "description": "Where an item comes from.",
      "enum": [
        "task_text",
        "intake",
        "inferred",
        "developer"
      ],
      "title": "OriginSource",
      "type": "string"
    },
    "ReviewRole": {
      "description": "The LLM roles a rule speaks to; each prompt gets only its role's rules.",
      "enum": [
        "reviewer",
        "fixer",
        "judge",
        "writer"
      ],
      "title": "ReviewRole",
      "type": "string"
    },
    "ReviewRule": {
      "additionalProperties": false,
      "description": "One review rule. `text` is the rule as the prompts number it; the other fields are\nwhat the mechanism reads from it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "applies_to": {
          "items": {
            "$ref": "#/$defs/ReviewRole"
          },
          "minItems": 1,
          "title": "Applies To",
          "type": "array"
        },
        "files": {
          "default": [],
          "items": {
            "pattern": "^\\.\\w+$",
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "when_found": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "When Found",
          "type": "array"
        },
        "until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until"
        },
        "replaces": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replaces"
        },
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "status": {
          "$ref": "#/$defs/ItemStatus"
        },
        "kind": {
          "$ref": "#/$defs/RuleKind"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "wordings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuleWording"
          },
          "title": "Wordings",
          "type": "array"
        },
        "shown_in": {
          "$ref": "#/$defs/RulePlace",
          "default": "rules"
        },
        "example": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleExample"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detectors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SafeFix"
          },
          "title": "Detectors",
          "type": "array"
        },
        "named_by": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Named By",
          "type": "array"
        },
        "approved_notes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ApprovedNote"
          },
          "title": "Approved Notes",
          "type": "array"
        },
        "forbidden_text": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ForbiddenText"
          },
          "title": "Forbidden Text",
          "type": "array"
        },
        "forbidden_change": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ForbiddenText"
          },
          "title": "Forbidden Change",
          "type": "array"
        },
        "never_a_violation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Never A Violation"
        },
        "clarification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clarification"
        }
      },
      "required": [
        "id",
        "applies_to",
        "origin",
        "status",
        "kind",
        "text"
      ],
      "title": "ReviewRule",
      "type": "object"
    },
    "RuleExample": {
      "additionalProperties": false,
      "description": "One edit that follows the rule, shown with the examples.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "find": {
          "title": "Find",
          "type": "string"
        },
        "replace": {
          "title": "Replace",
          "type": "string"
        }
      },
      "required": [
        "file",
        "find",
        "replace"
      ],
      "title": "RuleExample",
      "type": "object"
    },
    "RuleKind": {
      "description": "What a rule decides.",
      "enum": [
        "fix_allowed",
        "note_only",
        "never_do",
        "never_mention",
        "style"
      ],
      "title": "RuleKind",
      "type": "string"
    },
    "RulePlace": {
      "description": "Where the fixer's prompt shows a rule.",
      "enum": [
        "rules",
        "fix_kind"
      ],
      "title": "RulePlace",
      "type": "string"
    },
    "RuleWording": {
      "additionalProperties": false,
      "description": "A rule's text for a prompt whose edited file types are all in `files`.",
      "properties": {
        "files": {
          "items": {
            "pattern": "^\\.\\w+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "files",
        "text"
      ],
      "title": "RuleWording",
      "type": "object"
    },
    "SafeFix": {
      "description": "The registered detectors of small safe fixes. Each recognizes one shape of edit in\ncode; a `fix_allowed` rule chooses which of them the judge may never report.",
      "enum": [
        "missing_break",
        "id_assignment",
        "readonly_field",
        "stray_using",
        "controller_suffix",
        "final_newline",
        "client_reference",
        "assignment_in_condition"
      ],
      "title": "SafeFix",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One `review_rules.yaml`: the course's rules, or one assignment's.",
  "properties": {
    "rules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReviewRule"
      },
      "title": "Rules",
      "type": "array"
    },
    "examples": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FixExample"
      },
      "title": "Examples",
      "type": "array"
    }
  },
  "title": "ReviewRuleSet",
  "type": "object"
}
